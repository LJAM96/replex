# Copy to .env and fill in. .env is gitignored — never commit real values.
# All values are read by scripts/capture_baseline.sh, scripts/list_shared_users.sh,
# and (once implemented) integration tests in later phases.

# Plex server address as reachable from wherever Replex runs.
# For local testing: the server's LAN address is fine.
REPLEX_HOST=http://192.168.1.100:32400

# Server admin token (https://support.plex.tv/articles/204059436)
REPLEX_TOKEN=

# Optional: pin the capture targets so baseline runs are reproducible.
# Leave empty to auto-discover.
SECTION_ID=
MOVIE_RATING_KEY=
EPISODE_RATING_KEY=

# Optional: shared-user tokens for testing restricted accounts in later phases.
# Format: name=token, one per line, e.g.  lodie=xxxx
REPLEX_TEST_USER_TOKENS=
